# Host identity
HOST_ID="<your-host-id>"
HOME_DIR="/Users/<user>"
WORKSPACE_ROOT="/Users/<user>/workspace"
FILESYSTEM_MCP_ROOT="/Users/<user>"

# Isambard defaults
ISAMBARD_HOST_ALIAS="replace-me.cluster.example"
ISAMBARD_REMOTE_ROOT="~/codex_jobs"

# MCP shared non-secret settings
OUTLOOK_TENANT_ID="replace-me"

# Cloud layout
GITHUB_REPO="your-user/your-portable-config-repo"
ONEDRIVE_BACKUP_DIR="/Users/<user>/Library/CloudStorage/OneDrive-ORG/codex-portable-backup"

# Optional feature gates (reserved)
ENABLE_MCP_GITHUB="1"
ENABLE_MCP_OUTLOOK="1"
ENABLE_MCP_IONOS="1"
